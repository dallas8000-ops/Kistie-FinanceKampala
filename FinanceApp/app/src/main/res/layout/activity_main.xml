<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="48dp"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_xl">

                <TextView
                    style="@style/Text.OnPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:text="Kistie Finance"
                    android:textSize="13sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Business Dashboard"
                    android:textColor="@color/text_on_primary"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.85"
                    android:text="Accounting · Retail · Imports"
                    android:textColor="@color/accent_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Stats grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="@dimen/spacing_md"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Dashboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_icon_circle_sales">

                            <ImageView
                                android:layout_width="@dimen/icon_size_md"
                                android:layout_height="@dimen/icon_size_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sales" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Text.StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly Sales" />
                            <TextView android:id="@+id/tvTotalSales" style="@style/Text.StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="UGX 0" android:textColor="@color/stat_sales_icon" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Dashboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_icon_circle_profit">

                            <ImageView
                                android:layout_width="@dimen/icon_size_md"
                                android:layout_height="@dimen/icon_size_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_profit" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Text.StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly Profit" />
                            <TextView android:id="@+id/tvTotalProfit" style="@style/Text.StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="UGX 0" android:textColor="@color/success" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Dashboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_icon_circle_expense">

                            <ImageView
                                android:layout_width="@dimen/icon_size_md"
                                android:layout_height="@dimen/icon_size_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_expense" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Text.StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monthly Expenses" />
                            <TextView android:id="@+id/tvTotalExpenses" style="@style/Text.StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="UGX 0" android:textColor="@color/danger" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Dashboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/icon_circle"
                            android:layout_height="@dimen/icon_circle"
                            android:background="@drawable/bg_icon_circle_inventory">

                            <ImageView
                                android:layout_width="@dimen/icon_size_md"
                                android:layout_height="@dimen/icon_size_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_stock" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Text.StatLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inventory Value" />
                            <TextView android:id="@+id/tvInventoryValue" style="@style/Text.StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="UGX 0" android:textColor="@color/warning" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- CTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddSale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_cta_sale">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sales"
                            app:tint="@color/text_on_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Record New Sale"
                            android:textColor="@color/text_on_primary"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.8"
                            android:text="Log a sale and update stock instantly"
                            android:textColor="@color/accent_light"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:text="Accounting" />

            <include android:id="@+id/btnLedger" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnTrialBalance" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnReceivables" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnPayables" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnSalesHistory" layout="@layout/item_dashboard_menu" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:text="Operations" />

            <!-- Menu items -->
            <include android:id="@+id/btnHousehold" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnBusiness" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnInventory" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnShipments" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnReports" layout="@layout/item_dashboard_menu" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:text="Tools" />

            <include android:id="@+id/btnAiAssistant" layout="@layout/item_dashboard_menu" />
            <include android:id="@+id/btnSettings" layout="@layout/item_dashboard_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
